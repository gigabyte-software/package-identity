{
    "name": "gigabyte/laravel-identity",
    "description": "Passwordless code-based authentication for Laravel with Sanctum API tokens, magic links, and sliding token expiry.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gigabyte Software"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/mail": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gigabyte\\Identity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gigabyte\\Identity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gigabyte\\Identity\\IdentityServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
